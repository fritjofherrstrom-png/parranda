---
import { landingHero, proofCards, routeProofs } from '../landing-content';
import '../styles/tokens.css';
import '../styles/landing-proof.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Parranda Astro landing proof</title>
    <meta
      name="description"
      content="Static Astro proof for a future Parranda landing migration. No production route takeover."
    />
  </head>
  <body class="bg-parranda-paper text-parranda-ink">
    <main class="landing-proof-shell">
      <section class="landing-proof-hero" aria-labelledby="landing-proof-title">
        <nav class="landing-proof-nav" aria-label="Parranda proof navigation">
          <a class="landing-proof-brand" href="/">Parranda</a>
          <div class="landing-proof-nav__links" aria-label="Planner proof links">
            {routeProofs.map((route) => <a href={route.href}>{route.label}</a>)}
          </div>
        </nav>

        <div class="landing-proof-hero__grid">
          <div class="landing-proof-hero__copy">
            <p class="landing-proof-eyebrow">{landingHero.eyebrow}</p>
            <h1 id="landing-proof-title">{landingHero.title}</h1>
            <p class="landing-proof-lede">{landingHero.body}</p>
            <div class="landing-proof-actions">
              <a class="landing-proof-button landing-proof-button--primary" href={routeProofs[0].href}>
                {landingHero.primaryCta}
              </a>
              <a class="landing-proof-button landing-proof-button--secondary" href={routeProofs[1].href}>
                {landingHero.secondaryCta}
              </a>
            </div>
            <div class="landing-proof-city-strip" aria-label="Supported landing proof cities">
              {routeProofs.map((route) => (
                <a class="landing-proof-city-pill" href={route.href}>
                  <span>{route.status}</span>
                  <strong>{route.label}</strong>
                </a>
              ))}
            </div>
          </div>

          <aside class="landing-proof-phone" aria-label="Static mobile landing composition proof">
            <div class="landing-proof-phone__bar">Today · Barcelona</div>
            <div class="landing-proof-phone__card">
              <span>Pulse</span>
              <strong>Golden hour is pulling the evening west.</strong>
              <p>Use the planner to turn that signal into a city-time route.</p>
            </div>
            <div class="landing-proof-phone__card landing-proof-phone__card--warm">
              <span>Blitz</span>
              <strong>One move now, no itinerary spreadsheet.</strong>
            </div>
          </aside>
        </div>
      </section>

      <section class="landing-proof-cards" aria-label="Migration proof points">
        {proofCards.map((card) => (
          <article class="landing-proof-card">
            <p>{card.kicker}</p>
            <h2>{card.title}</h2>
            <span>{card.body}</span>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
