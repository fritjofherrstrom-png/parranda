---
// The any-city planner — the new frontend's first production-capable surface.
// The shell is intentionally BARE: all copy lives in the island so the language
// contract (EN default, ?lang=sv explicit) is honored fully client-side (static
// output cannot read query params at request time). Served in production by the
// Express app behind PARRANDA_NEW_ANYWHERE (see docs/FRONTEND_MIGRATION_CONTRACT.md).
import "../styles/tokens.css";
import "../styles/tailwind.css";
import AnywherePlanner from "../components/AnywherePlanner";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Parranda — any city</title>
    <meta
      name="description"
      content="Type any city. Parranda builds a day with the right rhythm, neighborhoods and timing — extra curated in Barcelona and Rome."
    />
  </head>
  <body>
    <main class="mx-auto flex w-full max-w-2xl flex-col gap-8 px-4 py-16">
      <AnywherePlanner client:load />
    </main>
  </body>
</html>
