---
// The any-city planner — the new frontend's first production-capable surface.
// The shell is intentionally BARE: all copy lives in the island. Express owns
// the request-time <html lang> contract for /anywhere because static Astro
// output cannot read query params directly.
import Shell from "../layouts/Shell.astro";
import AnywherePlanner from "../components/AnywherePlanner";
---

<Shell
  title="Parranda — any city"
  description="Type any city. Parranda builds a day with the right rhythm, neighborhoods and timing — extra curated in Barcelona and Rome."
>
  <main class="mx-auto flex w-full max-w-2xl flex-col px-4 pb-16 pt-3 sm:px-6 lg:max-w-[88rem] lg:px-8">
    <AnywherePlanner client:load />
  </main>
</Shell>
