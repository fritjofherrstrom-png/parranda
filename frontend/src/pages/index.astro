---
// The landing — the new frontend's second production surface (served by Express
// at GET / behind PARRANDA_NEW_LANDING; see docs/FRONTEND_MIGRATION_CONTRACT.md).
// The shell is bare: copy lives in the island (client-side lang per the language
// contract), and the CITY REGISTRY is injected by Express at serve time by
// replacing the __PARRANDA_LANDING_REGISTRY__ token below — a city is data,
// never code, and the static build never hardcodes one.
import "../styles/tokens.css";
import "../styles/tailwind.css";
import LandingHero from "../components/LandingHero";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Parranda — Next stop?</title>
    <meta
      name="description"
      content="Type any city. Parranda builds a day with the right rhythm, neighborhoods and timing."
    />
    <script is:inline>
      // Express replaces the QUOTED token with the real registry JSON at serve
      // time. Unreplaced (astro dev / flag off) it stays a harmless string — the
      // island type-guards and treats it as an empty registry.
      window.__PARRANDA_CITIES__ = "__PARRANDA_LANDING_REGISTRY__";
    </script>
  </head>
  <body>
    <LandingHero client:load />
  </body>
</html>
