---
// The landing — the new frontend's second production surface (served by Express
// at GET /; see docs/FRONTEND_MIGRATION_CONTRACT.md).
// The shell is bare: copy lives in the island (client-side lang per the language
// contract), and the CITY REGISTRY is injected by Express at serve time by
// replacing the __PARRANDA_LANDING_REGISTRY__ token below — a city is data,
// never code, and the static build never hardcodes one.
import Shell from "../layouts/Shell.astro";
import LandingHero from "../components/LandingHero";
---

<Shell
  title="Parranda — Next stop?"
  description="Type any city. Parranda builds a day with the right rhythm, neighborhoods and timing."
>
  <script is:inline slot="head">
    // Express replaces the QUOTED token with the real registry JSON at serve
    // time. Unreplaced (astro dev / flag off) it stays a harmless string — the
    // island type-guards and treats it as an empty registry.
    window.__PARRANDA_CITIES__ = "__PARRANDA_LANDING_REGISTRY__";
  </script>
  <LandingHero client:load />
</Shell>
