{
  "name": "parranda",
  "version": "1.0.0",
  "description": "Parranda är en city-intelligence PWA med planner, Pulse och Blitz för promenadvänliga dagsflöden över flera städer.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:full": "node scripts/dev-full.js",
    "dev:dogfood": "PARRANDA_DOGFOOD_UI=enabled node server.js",
    "migrate:source-catalog": "node scripts/migrate-source-catalog.js",
    "review:source-profile": "node scripts/review-source-profile.js",
    "scout:events": "node scripts/scout-local-event-sources.js",
    "worker:source-scout": "node scripts/run-source-scout-worker.js",
    "share": "node scripts/share.js",
    "share:latest": "node scripts/share-latest.js",
    "validate:self-hosted": "node scripts/validate-self-hosted-stack.js",
    "start": "node server.js",
    "test": "node --test",
    "build:frontend": "npm --prefix frontend run build",
    "check:frontend": "npm --prefix frontend run check",
    "test:frontend": "npm --prefix frontend run test",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "keywords": [
    "parranda",
    "city-intelligence",
    "rome",
    "barcelona",
    "athens",
    "travel",
    "pwa",
    "route-planner",
    "pulse",
    "blitz"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
