# Copy to /opt/parranda/.env.production on the host. Never commit the real file.

# Public hostname. Caddy provisions HTTPS automatically for a real DNS name.
PARRANDA_SITE_ADDRESS=parranda.example.com

# OCI image repository without a tag. The deploy script appends the exact SHA.
PARRANDA_IMAGE_REPOSITORY=ghcr.io/fritjofherrstrom-png/parranda

# Identify your installation responsibly to Nominatim. Include a real contact URL/email.
PARRANDA_PLACE_RESOLVER_USER_AGENT=Parranda self-hosted (contact: you@example.com)

# Optional tuning. Defaults remain intentionally conservative.
PARRANDA_PUBLIC_GUARD_MAX=20
PARRANDA_PUBLIC_GUARD_WINDOW_MS=60000
PARRANDA_PUBLIC_GUARD_CONCURRENCY=8
PARRANDA_WIKIDATA_LABEL_LANGS=en
