# Copy to /opt/parranda/.env.production on the host. Never commit the real file.

# Public hostname. Caddy provisions HTTPS automatically for a real DNS name.
PARRANDA_SITE_ADDRESS=parranda.example.com

# OCI image repository without a tag. The deploy script appends the exact SHA.
PARRANDA_IMAGE_REPOSITORY=ghcr.io/fritjofherrstrom-png/parranda

# Identify your installation responsibly to Nominatim. Include a real contact URL/email.
PARRANDA_PLACE_RESOLVER_USER_AGENT=Parranda self-hosted (contact: you@example.com)

# Optional tuning. Defaults remain intentionally conservative.
PARRANDA_PUBLIC_GUARD_MAX=20
PARRANDA_PUBLIC_GUARD_WINDOW_MS=60000
PARRANDA_PUBLIC_GUARD_CONCURRENCY=8
PARRANDA_WIKIDATA_LABEL_LANGS=en

# Pedestrian route geometry for the final modern Planner stop chain.
# Leave heuristic until the operator has accepted provider capacity/privacy.
PARRANDA_WALKING_PROVIDER=heuristic
# Low-volume single-process trial only (max 1 request/sec, no heavy use):
# PARRANDA_WALKING_PROVIDER=osrm
# PARRANDA_OSRM_URL=https://routing.openstreetmap.de/routed-foot/
# Custom/self-hosted OSRM must actually be preprocessed for foot transport:
# PARRANDA_OSRM_TRANSPORT_MODE=foot
# See docs/WALKING_GEOMETRY.md before enabling across multiple replicas.

# Optional persistent geo Source Catalog. Leave disabled until the catalog
# migration is wanted. The password must be URL-safe because the same secret is
# included in the private-network connection URL.
PARRANDA_SOURCE_CATALOG=disabled
# Automatic Live supply from fresh, repeatedly healthy catalog candidates.
# These remain low-trust, Pulse-only and expire automatically; they never become
# route stops or approved source rows.
# Set disabled only to explicitly opt out of machine-qualified event sources.
PARRANDA_QUALIFIED_SOURCE_RUNTIME=enabled
# PARRANDA_SOURCE_CATALOG_PASSWORD=replace-with-a-long-url-safe-secret
# PARRANDA_SOURCE_CATALOG_DATABASE_URL=postgresql://parranda:replace-with-a-long-url-safe-secret@postgres:5432/parranda
# PARRANDA_EVENT_SOURCE_SCOUT_INTERVAL_MS=300000

# Main reader for public local event documents; credentials stay server-side.
# Exact quoted facts are verified before qualification / Live display.
PARRANDA_EVENT_READER=enabled
PARRANDA_EVENT_READER_MODEL=gpt-6-luna
# OPENAI_API_KEY=replace-with-a-private-api-key
# France-wide DATAtourisme Live events. No per-commune activation is required.
# Missing credentials remain an unavailable source, not an empty calendar.
# PARRANDA_DATATOURISME_KEY=replace-with-a-private-api-key
# Optional preinstalled Tesseract language-data directory or trusted data URL.
# PARRANDA_OCR_LANG_PATH=/server-owned/path/to/traineddata

# Landing place autocomplete (Photon geographic search). Replace with a hosted
# instance for higher traffic; disabled leaves ordinary free-text submit usable.
PARRANDA_PLACE_SUGGESTIONS=enabled
PARRANDA_PLACE_SUGGESTIONS_ENDPOINT=https://photon.komoot.io/api/
